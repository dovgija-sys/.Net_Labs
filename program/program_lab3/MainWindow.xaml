<Window x:Class="program_lab3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Furniture Management" Height="680" Width="900" Background="#F5F5F5" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4a412a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,15,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24*"/>
            <ColumnDefinition Width="401*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="New Furniture" Grid.Row="0" Grid.ColumnSpan="2" Margin="10,10,10,10">
            <StackPanel Orientation="Vertical">
                <Label Content="Choose furniture class:"/>
                <ComboBox x:Name="FurnitureTypeComboBox" Width="200" HorizontalAlignment="Left" SelectionChanged="FurnitureTypeComboBox_SelectionChanged" Margin="0,0,0,10">
                    <ComboBoxItem Content="Table"/>
                    <ComboBoxItem Content="Chair"/>
                    <ComboBoxItem Content="Wardrobe"/>
                </ComboBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Type:"/>
                        <Label Content="" Height="22"/>
                        <Label Content="Material:"/>
                        <Label Content="" Height="15"/>
                        <Label Content="Price ($):"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBox x:Name="TypeTextBox"/>
                        <TextBox x:Name="MaterialTextBox"/>
                        <TextBox x:Name="PriceTextBox"/>
                    </StackPanel>

                    <StackPanel x:Name="TableFields" Grid.Column="3" Visibility="Visible">
                        <Label Content="Table shape:"/>
                    </StackPanel>
                    <StackPanel x:Name="TableInputs" Grid.Column="4" Visibility="Visible">
                        <TextBox x:Name="ShapeTextBox"/>
                    </StackPanel>

                    <StackPanel x:Name="ChairFields" Grid.Column="3" Visibility="Collapsed">
                        <Label Content=""/>
                    </StackPanel>
                    <StackPanel x:Name="ChairInputs" Grid.Column="4" Visibility="Collapsed" VerticalAlignment="Center">
                        <CheckBox x:Name="HeightAdjustmentCheckBox" Content="Height Adjustment" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="WardrobeFields" Grid.Column="3" Visibility="Collapsed">
                        <Label Content="Doors count:"/>
                    </StackPanel>
                    <StackPanel x:Name="WardrobeInputs" Grid.Column="4" Visibility="Collapsed">
                        <TextBox x:Name="DoorsTextBox" Text="2"/>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,5,0,0">
                    <Button x:Name="AddButton" Content="Add" Click="AddButton_Click" Margin="0,10,10,0"/>
                    <Button x:Name="AssembleButton" Content="Assemble" Click="AssembleButton_Click" Margin="0,10,10,0"/>
                    <Button x:Name="CleanButton" Content="Clean" Click="CleanButton_Click" Margin="0,10,10,0"/>
                    <Button x:Name="GetDimensionsButton" Content="Get Dimensions" Click="GetDimensionsButton_Click" Margin="0,10,10,0"/>
                    <Button x:Name="GetInstructionButton" Content="Get Instruction" Click="GetInstructionButton_Click" Margin="0,10,10,0"/>
                    <Button x:Name="AssembleAllButton" Content="Assemble All" Click="AssembleAllButton_Click" Margin="0,10,10,0"/>
                    <Button x:Name="AllInstructionsButton" Content="All Instructions" Click="AllInstructionsButton_Click" Margin="0,10,10,0"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Furniture (select item)" Grid.Column="0" Margin="10,10,5,10">
                <ListBox x:Name="FurnitureObjectsListBox" Margin="5" BorderBrush="#E0E0E0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Type}" FontWeight="SemiBold"/>
                                <TextBlock Text=" | "/>
                                <TextBlock Text="{Binding Material}"/>
                                <TextBlock Text=" | $"/>
                                <TextBlock Text="{Binding Price}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <GroupBox Header="List of operations" Grid.Column="1" Margin="5,10,10,10">
                <ListBox x:Name="FurnitureListBox" Margin="5" BorderBrush="#E0E0E0"/>
            </GroupBox>
        </Grid>

        <GroupBox Header="Total price analytics" Grid.Row="2" Grid.ColumnSpan="2" Margin="10,10,10,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Label Content="Material:"/>
                <TextBox x:Name="SearchMaterialTextBox" Width="150" Margin="10,0,10,0" TextChanged="SearchMaterialTextBox_TextChanged"/>
                <TextBlock Text="Total Price: " FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TotalMaterialPriceTextBlock" Text="$0.00" Foreground="#4a412a" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>